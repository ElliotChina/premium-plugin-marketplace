{
  "schema_version": "company-analysis-valuation-model-catalog-v2",
  "calculator_version": "company-analysis-valuation-calculator-v2",
  "method_id_vocabulary": {
    "indicator": {
      "multiple": "倍数（价格倍数、企业价值倍数）",
      "yield": "收益率（价格倒数形式）",
      "intrinsic-price-per-share": "内在每股价值（DCF、RIM、rNPV、内含价值、SOTP）"
    },
    "basis": {
      "eps": "每股盈利",
      "book": "每股净资产",
      "revenue": "收入",
      "ebitda": "息税折旧摊销前利润",
      "ebit": "息税前利润",
      "fcf": "自由现金流",
      "fcfe": "股权自由现金流",
      "dividend": "每股股息",
      "nav": "净资产价值",
      "ffo": "REIT 营运现金流",
      "residual-income": "剩余收益",
      "rnpv": "风险调整净现值（管线）",
      "embedded-value": "内含价值"
